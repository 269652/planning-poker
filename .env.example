# Copy to .env.local and adjust. Everything here is optional:
# without Jira settings the app still works with manually added tickets.

PORT=3000
# Interface to bind (0.0.0.0 = reachable by teammates on your network)
HOST=0.0.0.0
# Extra origins allowed to open the websocket (comma separated), e.g. when behind a proxy
# that rewrites the Host header. Same-host origins are always allowed.
# ALLOWED_ORIGINS=https://poker.example.com

# --- Try it without a Jira account: in-memory demo boards, write-backs are recorded in memory ---
# JIRA_MODE=mock

# --- Jira Cloud (REST v3): email + API token (https://id.atlassian.com/manage-profile/security/api-tokens) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=xxxxxxxx

# --- Jira Server / Data Center (REST v2): personal access token ---
# JIRA_BASE_URL=https://jira.example.com
# JIRA_PAT=xxxxxxxx

# Optional overrides
# JIRA_API_VERSION=3                       # 3 = Cloud (default for email+token), 2 = Server/DC (default for PAT)
# JIRA_STORY_POINTS_FIELD=customfield_10016  # auto-detected by name ("Story point estimate" / "Story Points") if unset
# JIRA_DEFAULT_JQL=statusCategory != Done  # filter applied when importing a board/sprint
