# Copy to .env.local and adjust. All values are optional; without Jira settings the app
# works with manually added tickets only.

# --- Server -------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0          # bind address; 0.0.0.0 lets teammates on your network join
# DATA_DIR=./data       # rooms are persisted to <DATA_DIR>/rooms.json (contains secrets, mode 0600)

# --- Jira (pick ONE of the modes below) ----------------------------------
# Demo mode: built-in fake board, no credentials. Same as `npm run demo`.
# JIRA_MOCK=1

# Jira Cloud: base URL + account email + API token
# (https://id.atlassian.com/manage-profile/security/api-tokens)
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@your-company.com
# JIRA_API_TOKEN=xxxxxxxx

# Jira Server / Data Center: personal access token, bearer auth (no email needed)
# JIRA_AUTH=bearer

# Optional: skip auto-discovery of the Story Points field (e.g. customfield_10016)
# JIRA_STORY_POINTS_FIELD=customfield_10016
