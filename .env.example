# Credentials for the local Jira helper (public/jira-helper.mjs) — only the person who HOSTS rooms
# needs this. Copy to .env next to jira-helper.mjs (or in the repository root for `npm run jira-helper`).
# The helper reads it; the browser never sees these values. Never commit a real .env.

# --- Jira Cloud: base URL + account email + API token ---------------------
# (create a token at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=xxxxxxxx

# --- Jira Server / Data Center: personal access token, bearer auth ---------
# JIRA_BASE_URL=https://jira.example.com/jira
# JIRA_API_TOKEN=xxxxxxxx            # or JIRA_PERSONAL_TOKEN=xxxxxxxx
# JIRA_AUTH=bearer

# Optional: skip auto-discovery of the Story Points field (e.g. customfield_10016)
# JIRA_STORY_POINTS_FIELD=customfield_10016

# Optional helper settings (command-line flags --origin / --port do the same)
# HELPER_ORIGINS=https://you.github.io,http://localhost:3000
# HELPER_PORT=8787
