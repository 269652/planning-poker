{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime Scrum Planning Poker: a static site where the host's browser runs the room, connected through a WebSocket relay on Vercel, with Jira import and write-back via a local helper",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node tools/preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "jira-helper": "node public/jira-helper.mjs",
    "relay": "node relay/dev.js"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "ioredis": "5.4.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2",
    "ws": "8.23.0"
  }
}
