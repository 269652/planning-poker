{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime Scrum Planning Poker that runs entirely in the browser (Next.js static export + WebRTC), with Jira import and estimate write-back from the host's browser",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node tools/preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "jira-helper": "node public/jira-helper.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "peerjs": "1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  }
}
